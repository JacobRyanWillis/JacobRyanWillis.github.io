# Local Directus authoring environment (docker compose up -d)
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=portfolio

# Set this when running `pnpm dev` to render live from Directus
# (enables the visual editor). Leave unset to render from the
# committed content snapshot, exactly like the production build.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
